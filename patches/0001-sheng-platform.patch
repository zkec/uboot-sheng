+	reg = pmic_reg_read(plat->pmic, gpio_base +
+			    (plat->lv_mv_type ? REG_RT_STATUS : REG_STATUS));
 	if (reg < 0)
 		return reg;
 
@@ -322,7 +326,9 @@ static int qcom_gpio_probe(struct udevice *dev)
 	}
 
