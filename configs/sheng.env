# Native Android / Debian menu; no EFI or persistent-storage commands.
bootdelay=0
bootretry=1
stdin=serial,button-kbd
stdout=serial,vidconsole
stderr=serial,vidconsole
preboot=sleep 1
bootcmd=run menucmd
menucmd=while true; do sheng_menu; bootmenu -1; done
fastboot=fastboot -l $fastboot_addr_r usb 0
native=if fdt addr ${fdt_addr_r} && fdt resize 0x10000 && fdt rm /chosen/framebuffer && fdt get value bootargs /chosen sheng,linux-bootargs; then setenv bootm_low a8000000; setenv bootm_size 10000000; setenv initrd_high ffffffffffffffff; setenv fdt_high ffffffffffffffff; bootm ${prevbl_initrd_start_addr}#native ${prevbl_initrd_start_addr}:ramdisk ${fdt_addr_r}; fi
bootmenu_0=Android=sheng_android; pause
slotswitch=if fdt addr ${fdt_addr_r} && fdt resize 0x10000 && fdt set /chosen sheng,slot-switch other; then run native; fdt addr ${fdt_addr_r}; fdt rm /chosen sheng,slot-switch; fi
bootmenu_1=Linux=run native
bootmenu_2=Restart=sheng_power restart
bootmenu_3=Bootloader=sheng_power bootloader
bootmenu_4=Power off=sheng_power poweroff
bootmenu_5=Switch slot=run slotswitch
